# Copy this file to .env and fill in your values

# ── Database (SQLite) ────────────────────────────────────────────────────────
# Optional: override the default SQLite file path (default: ./intern_tracker.db)
# SQLITE_DB_PATH=./intern_tracker.db

# ── GitLab ───────────────────────────────────────────────────────────────────
# Set to "false" to disable SSL certificate verification
# Useful when using a self-signed cert on a private GitLab instance
GITLAB_SSL_VERIFY=true

# Optional server-side fallback credentials (frontend can override per-request)
GITLAB_URL=https://code.swecha.org
GITLAB_TOKEN=

# ── GitLab OAuth Login ───────────────────────────────────────────────────────
#
# You do NOT need GitLab admin access. Follow these steps as a regular user:
#
# Step 1 — Open your GitLab profile settings:
#           https://code.swecha.org/-/profile/applications
#           (Profile picture → Edit Profile → Applications in left sidebar)
#
# Step 2 — Click "Add new application" and fill in:
#           Name:          Internship Tracker
#           Redirect URI:  http://localhost:8000/api/auth/gitlab/callback
#           Confidential:  ✅ checked
#           Scopes:        ✅ api
#
# Step 3 — Click "Save application"
#           GitLab will show you the Application ID and Secret.
#           Copy them into GITLAB_OAUTH_CLIENT_ID and GITLAB_OAUTH_CLIENT_SECRET below.
#
# Note: For production, update GITLAB_OAUTH_REDIRECT_URI to your real backend URL.
#
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/gitlab/callback

# Frontend URL — where to redirect the browser after successful GitLab login
FRONTEND_APP_URL=http://localhost:5173

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Browser Session ──────────────────────────────────────────────────────────
# Corpus/GitLab tokens are held server-side and keyed by this HTTP-only cookie.
SESSION_COOKIE_NAME=iat_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for the React frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
