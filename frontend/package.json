{
  "name": "team-standup-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp lint .",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check src/ tests/",
    "typecheck": "vp lint . --type-aware --type-check -A all",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "changelog": "node scripts/updateChangelog.js --auto",
    "changelog:update": "node scripts/updateChangelog.js",
    "validate:i18n": "node scripts/validateI18n.mjs",
    "validate:i18n:usage": "node scripts/validateI18nUsage.mjs",
    "i18n:replace": "node scripts/validateI18nUsage.mjs",
    "validate": "vp check && node scripts/validateI18n.mjs && vp test run",
    "validate:staged": "vp staged",
    "prepare": "node scripts/setupGitHooks.mjs",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:strict": "knip --include exports,files,dependencies"
  },
  "dependencies": {
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.0.18",
    "knip": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.12.1"
}
